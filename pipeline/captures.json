 {
  "name": "repo-tree",
  "title": "The repo, two levels deep",
  "command": "pipeline/tree.sh | pr -2 -t -w 104",
  "max_lines": 24
 },
 {
  "name": "agent-file",
  "title": "An agent is a markdown file",
