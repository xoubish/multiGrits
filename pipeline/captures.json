  "max_lines": 14
 },
 {
  "name": "fanout-readme",
  "title": "Run 001: four researchers in parallel",
  "command": "sed -n '/^## Outcome/,/^Merged by/p' runs/001-research-fanout/README.md",
  "max_lines": 24
 },
 {
  "name": "stage-write",
  "title": "stage_write: two worktrees, one merge",
  "command": "sed -n '/^  for w in slides diagrams; do$/,/^  wait$/p' pipeline/run.sh",
  "max_lines": 20
 },
 {
  "name": "git-log",
  "title": "The merge commit records a real conflict",
  "command": "git log --format='%h  %s' | head -8",
  "max_lines": 12
 },
 {
  "name": "conflict-readme",
  "title": "Run 004: two agents, one file",
