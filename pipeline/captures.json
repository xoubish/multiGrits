  "max_lines": 26
 },
 {
  "name": "budget-hit",
  "title": "Run 006 hit the budget cap",
  "command": "python3 -c \"import json; d=json.load(open('runs/006-revise/result.json')); [print(f'{k:18s} {d.get(k)}') for k in ('subtype','is_error','terminal_reason','num_turns','total_cost_usd','duration_ms')]\"",
  "max_lines": 10
 },
 {
